{
  "name": "gochiso-globe",
  "private": true,
  "description": "ごちそう地球儀 — 回せる地球儀(平面地図も)、現代の国と都市、タイムスリップ(世界史の地図と図鑑)、郷土料理、国クイズ、オンライン対戦",
  "scripts": {
    "map": "node build/simplify.js 0.3",
    "data": "node build/build.js",
    "site": "python3 build/assemble.py",
    "build": "node build/build.js && python3 build/assemble.py",
    "history": "node --max-old-space-size=8000 build/history.js"
  },
  "devDependencies": {
    "d3": "7.9.0",
    "polygon-clipping": "^0.15.7",
    "polylabel": "^1.1.0",
    "topojson-client": "3.1.0",
    "topojson-server": "^3.0.1",
    "topojson-simplify": "^3.0.3",
    "world-atlas": "^2.0.2",
    "world-countries": "^5.1.0"
  }
}
